# Frontend (Vite) — optional override; defaults to same-origin /api via the dev proxy
VITE_API_URL=/api
VITE_GOOGLE_MAPS_API_KEY=your_actual_key_here
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend (api/.env) — copy these into api/.env
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASS=your_supabase_database_password
SUPABASE_URL=https://your-project-ref.supabase.co
SESSION_SECRET=change-me
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
