# Frontend (Vite) — optional override; defaults to same-origin /api via the dev proxy
VITE_API_URL=/api
VITE_GOOGLE_MAPS_API_KEY=your_actual_key_here

# Backend (api/.env) — copy these into api/.env
DB_HOST=localhost
DB_PORT=3306
DB_NAME=magusdaclub
DB_USER=root
DB_PASS=
SESSION_SECRET=change-me
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
